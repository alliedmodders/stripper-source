import os

name = "stripper"

project_sources = [
	'stripper_mm.cpp'
]

project = builder.LibraryProject(name)
project.sources += project_sources

for sdk_target in MMS.sdk_targets:
	sdk = sdk_target.sdk
	cxx = sdk_target.cxx

	binary = MMS.HL2Config(project, builder, cxx, f"{name}.{sdk['extension']}", sdk)
	MMS.AddVersioning(binary)


MMS.binaries += builder.Add(project)
