import os

name = 'stripper.core'

project_sources = [
	'parser.cpp',
	'support.cpp'
]

for cxx in MMS.all_targets:

	binary = MMS.Library(cxx, name)

	binary.sources = [
		'parser.cpp',
		'support.cpp'
	]
	binary.compiler.defines += ['META_NO_HL2SDK', 'PCRE_STATIC']
	binary.compiler.cxxincludes += [os.path.join(MMS.mms_root, 'core', 'sourcehook')]

	lib_prefix = "" if cxx.target.platform == "windows" else "lib"
	lib_suffix = "lib" if cxx.target.platform == "windows" else "a"
	binary.compiler.postlink += [os.path.join(builder.sourcePath, "pcre_lib",
									f"{cxx.target.platform}-{binary.compiler.target.arch}",
									f"{lib_prefix}pcre.{lib_suffix}")]

	nodes = builder.Add(binary)
	MMS.binaries += [nodes]
