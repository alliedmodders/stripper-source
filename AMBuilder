import os

name = 'stripper.core'

project_sources = [
	'parser.cpp',
	'support.cpp'
]

project = builder.LibraryProject(name)
project.sources += project_sources

for sdk_target in MMS.sdk_targets:
	sdk = sdk_target.sdk
	if sdk['name'] == 'mock':
		continue

	binary = MMS.HL2Config(project, builder, cxx, f"{name}.ext.{sdk['extension']}", sdk)

	lib_prefix = "" if cxx.target.platform == "windows" else "lib"
	lib_suffix = "lib" if cxx.target.platform == "windows" else "a"
	binary.compiler.postlink += [os.path.join(builder.sourcePath, "pcre_lib",
										   f"{cxx.target.platform}-{binary.compiler.target.arch}", f"{lib_prefix}pcre.{lib_suffix}")]

SM.binaries += [builder.Add(project)]
