import os.path

name = 'stripper.core'

libpcre2 = builder.Build('third_party/AMBuild.pcre2')
for cxx in MMS.all_targets:

	binary = MMS.Library(cxx, name)

	binary.sources = [
		'parser.cpp',
		'support.cpp'
	]
	binary.compiler.defines += ['PCRE2_STATIC', 'PCRE2_CODE_UNIT_WIDTH=8']

	binary.compiler.sourcedeps += [libpcre2['header']]
	binary.compiler.includes += [os.path.dirname(os.path.join(builder.buildPath, libpcre2['header'].path))]
	binary.compiler.postlink += [libpcre2[binary.compiler.target.arch].binary]

	nodes = builder.Add(binary)
	MMS.binaries += [nodes]
