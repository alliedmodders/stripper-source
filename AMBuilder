import os.path

name = 'stripper.core'

for cxx in MMS.all_targets:

	binary = MMS.Library(cxx, name)

	binary.sources = [
		'parser.cpp',
		'support.cpp'
	]
	binary.compiler.cxxincludes += [os.path.join(MMS.mms_root, 'core', 'sourcehook')]

	if cxx.target.platform == 'linux':
		pcre_lib = 'libpcre2-8-linux.a' if cxx.target.arch == 'x86' else 'libpcre2-8-linux64.a'
		binary.compiler.postlink += [os.path.join(builder.sourcePath, 'pcre', pcre_lib)]
	elif cxx.target.platform == 'windows':
		pcre_lib = 'libpcre2-8-windows.lib' if cxx.target.arch == 'x86' else 'libpcre2-8-windows64.lib'
		binary.compiler.postlink += [os.path.join(builder.sourcePath, 'pcre', pcre_lib)]

	nodes = builder.Add(binary)
	MMS.binaries += [nodes]
