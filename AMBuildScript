import os


def ResolveEnvPath(env, folder):
	if env in os.environ and os.path.isdir(os.environ[env]):
		return os.environ[env]

	head = os.getcwd()
	while head:
		path = os.path.join(head, folder)
		if os.path.isdir(path):
			return path
		parent = os.path.dirname(head)
		if parent == head:
			break
		head = parent
	return None


def Normalize(path):
	return os.path.abspath(os.path.normpath(path))


manifest_helper = os.path.join(builder.sourcePath, 'hl2sdk-manifests', 'SdkHelpers.ambuild')
if not os.path.exists(manifest_helper):
	if not builder.options.hl2sdk_manifest:
		raise Exception('hl2sdk-manifests is missing; initialize submodules or pass --hl2sdk-manifest-path')
	manifest_helper = os.path.join(builder.options.hl2sdk_manifest, 'SdkHelpers.ambuild')
if not os.path.exists(manifest_helper):
	raise Exception('Could not find SdkHelpers.ambuild')
SdkHelpers = builder.Eval(manifest_helper, {'Project': 'stripper'})


class MMSConfig(object):
	def __init__(self):
		self.sdks = {}
		self.sdk_manifests = []
		self.sdk_targets = []
		self.binaries = []
		self.generated_headers = None
		self.mms_root = None
		self.all_targets = []
		self.target_archs = set()

		target_archs = builder.options.targets.split(',') if builder.options.targets else ['x86', 'x86_64']
		for arch in target_archs:
			try:
				cxx = builder.DetectCxx(target_arch=arch)
				self.target_archs.add(cxx.target.arch)
				self.all_targets.append(cxx)
			except Exception as ex:
				if builder.options.targets:
					raise
				print('Skipping target {}: {}'.format(arch, ex))

		if not self.all_targets:
			raise Exception('No suitable C/C++ compiler was found.')

	def detectProductVersion(self):
		builder.AddConfigureFile('product.version')

		# For OS X dylib versioning.
		import re
		with open(os.path.join(builder.sourcePath, 'product.version'), 'r') as fp:
			productContents = fp.read()
		m = re.match('(\\d+)\\.(\\d+)\\.(\\d+).*', productContents)
		if m is None:
			self.productVersion = '1.0.0'
		else:
			major, minor, release = m.groups()
			self.productVersion = '{0}.{1}.{2}'.format(major, minor, release)

	def findSdkPath(self, sdk_name):
		folder = 'hl2sdk-{}'.format(sdk_name)
		if builder.options.hl2sdk_root:
			path = os.path.join(builder.options.hl2sdk_root, folder)
			if os.path.isdir(path):
				return Normalize(path)
		return ResolveEnvPath('HL2SDK{}'.format(sdk_name.upper()), folder)

	def detectSDKs(self):
		SdkHelpers.sdk_filter = lambda sdk: not sdk.get('source2', False)
		SdkHelpers.find_sdk_path = self.findSdkPath
		sdk_list = [sdk for sdk in builder.options.sdks.split(',') if sdk]
		SdkHelpers.findSdks(builder, self.all_targets, sdk_list)
		self.sdks = SdkHelpers.sdks
		self.sdk_manifests = SdkHelpers.sdk_manifests
		self.sdk_targets = SdkHelpers.sdk_targets

		if builder.options.mms_path:
			self.mms_root = Normalize(builder.options.mms_path)
		else:
			self.mms_root = ResolveEnvPath('MMSOURCE', 'metamod-source')
		if not self.mms_root or not os.path.isdir(self.mms_root):
			raise Exception('Could not find a source copy of Metamod:Source')

	def configure(self):
		for cxx in self.all_targets:
			if cxx.target.arch not in ['x86', 'x86_64']:
				raise Exception('Unknown target architecture: {}'.format(cxx.target.arch))

			if cxx.like('gcc'):
				cxx.defines += [
					'stricmp=strcasecmp',
					'_stricmp=strcasecmp',
					'_snprintf=snprintf',
					'_vsnprintf=vsnprintf',
					'HAVE_STDINT_H',
					'GNUC',
				]
				cxx.cflags += [
					'-pipe',
					'-fno-strict-aliasing',
					'-Wall',
					'-Werror',
					'-Wno-uninitialized',
					'-Wno-unused',
					'-Wno-switch',
					'-msse',
					'-fPIC',
				]
				if cxx.target.arch == 'x86':
					cxx.cflags += ['-m32']
					cxx.linkflags += ['-m32']
				else:
					cxx.cflags += ['-m64']
					cxx.linkflags += ['-m64']
				cxx.cxxflags += [
					'-std=c++14',
					'-fno-exceptions',
					'-fno-rtti',
					'-fno-threadsafe-statics',
					'-Wno-non-virtual-dtor',
					'-Wno-overloaded-virtual',
					'-Wno-deprecated-register',
					'-Wno-implicit-const-int-float-conversion',
					'-Wno-expansion-to-defined',
				]
				if cxx.family == 'gcc':
					cxx.cflags += ['-mfpmath=sse']
				if cxx.target.platform == 'linux':
					cxx.defines += ['LINUX', '_LINUX', 'POSIX', '_FILE_OFFSET_BITS=64']
					cxx.linkflags += ['-lm']
					if cxx.family == 'gcc':
						cxx.linkflags += ['-static-libgcc']
					else:
						cxx.linkflags += ['-lgcc_eh']
			elif cxx.like('msvc'):
				cxx.defines += [
					'_CRT_SECURE_NO_DEPRECATE',
					'_CRT_SECURE_NO_WARNINGS',
					'_CRT_NONSTDC_NO_DEPRECATE',
				]
				cxx.cflags += ['/MT', '/W3', '/Zi', '/Oy-']
				cxx.cxxflags += ['/TP']
				cxx.linkflags += [
					'/SUBSYSTEM:WINDOWS',
					'kernel32.lib',
					'user32.lib',
					'gdi32.lib',
					'winspool.lib',
					'comdlg32.lib',
					'advapi32.lib',
					'shell32.lib',
					'ole32.lib',
					'oleaut32.lib',
					'uuid.lib',
					'odbc32.lib',
					'odbccp32.lib',
				]

			if builder.options.opt == '1':
				cxx.defines += ['NDEBUG']
				if cxx.like('gcc'):
					cxx.cflags += ['-O3']
				else:
					cxx.cflags += ['/Ox', '/Zo']
					cxx.linkflags += ['/OPT:ICF', '/OPT:REF']
			if builder.options.debug == '1':
				cxx.defines += ['DEBUG', '_DEBUG']
				if cxx.like('gcc'):
					cxx.cflags += ['-g3']
				else:
					cxx.cflags += ['/Od', '/RTC1']

			if cxx.target.platform == 'windows':
				cxx.defines += ['WIN32', '_WINDOWS']
			elif cxx.target.platform == 'mac':
				cxx.defines += ['OSX', '_OSX', 'POSIX']

			cxx.defines += ['STRIPPER_GENERATED_BUILD']
			cxx.includes += [os.path.join(builder.buildPath, 'includes')]

	def AddVersioning(self, binary):
		if binary.compiler.target.platform == 'windows':
			binary.sources += ['version.rc']
			binary.compiler.rcdefines += [
				'BINARY_NAME="{0}"'.format(binary.outputFile),
				'RC_COMPILE',
			]
		elif binary.compiler.target.platform == 'mac' and binary.type == 'library':
			binary.compiler.postlink += [
				'-compatibility_version', '1.0.0',
				'-current_version', self.productVersion,
			]
		binary.compiler.sourcedeps += self.generated_headers
		return binary

	def Library(self, cxx, name):
		binary = cxx.Library(name)
		self.AddVersioning(binary)
		return binary

	def HL2Library(self, context, cxx, name, sdk):
		compiler = cxx.clone()
		compiler.cxxincludes += [
			os.path.join(self.mms_root, 'core'),
			os.path.join(self.mms_root, 'core', 'sourcehook'),
		]
		for other_sdk in self.sdk_manifests:
			compiler.defines += ['SE_{}={}'.format(other_sdk['define'], other_sdk['code'])]
		binary = self.Library(compiler, name)
		SdkHelpers.configureCxx(context, binary, sdk)
		return binary


MMS = MMSConfig()
MMS.detectProductVersion()
MMS.detectSDKs()
MMS.configure()

MMS.generated_headers = builder.Build(
	'buildbot/Versioning',
	{'MMS': MMS}
)

BuildScripts = [
	'AMBuilder',
	'gameshim/AMBuilder',
	'loader/AMBuilder',
]

if builder.backend == 'amb2':
	BuildScripts += ['PackageScript']

builder.Build(BuildScripts, {'MMS': MMS})
